{
  "api": "https://starwars.fandom.com/api.php",
  "site": "https://starwars.fandom.com/wiki/",
  "user_agent": "SL100-Wiki/1.0 (+https://github.com/AndrisArickson/SL100-Wiki; personal non-commercial RPG reference; gentle single-threaded)",

  "delay_seconds": 2.5,
  "batch_size": 50,
