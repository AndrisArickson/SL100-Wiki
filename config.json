  "priority_roots": {
    "Weapons": 10,
    "Armor": 10,
    "Equipment": 12,
    "Starships": 11,
    "Vehicles": 11,
    "Droids": 12,
    "Sentient species": 13,
    "Planets": 13,
    "Force powers": 10,
    "Organizations": 15,
    "Galactic governments": 15,
    "Individuals by occupation": 20
  },

  "placeholder_max_px": 640,
  "placeholder_default_size": [300, 200],
  "placeholder_rgb": [205, 211, 217],

  "server_host": "127.0.0.1",
  "server_port": 8100
}
