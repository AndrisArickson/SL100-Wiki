# Local state / regenerable data
data/
__pycache__/
*.pyc
*.tmp
# Images: all images are committed. Only Creative Commons images (Wookieepedia, CC BY-SA 3.0, attribution in
# meta/card_images.tsv / meta/images.tsv) or our own artwork may be placed in images/.
# Fair-use / untagged Wookieepedia images: private local wiki only, never pushed
images/local/
# Copyrighted source-book extracts must never be pushed
private/
Source_Text/

# full-size JPG masters live outside the repo in ../art_originals
images/generated/originals/*.jpg
images/generated/*.jpg
images/full/**/*.png
images/full/**/*.jpg
